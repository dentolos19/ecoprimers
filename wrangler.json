{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ecoprimers",
  "main": "src/server.ts",
  "compatibility_date": "2026-09-01",
  "dev": {
    "host": "localhost:3000"
  },
  "observability": {
    "enabled": true
  },
  "route": {
    "pattern": "ecoprimers.dennise.me",
    "custom_domain": true
  },
  "containers": [
    {
      "name": "ecoprimers-container",
      "class_name": "Container",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "CONTAINER",
        "class_name": "Container"
      }
    ]
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Container"],
      "tag": "v1"
    }
  ]
}
