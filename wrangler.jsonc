{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ecoprimers",
  "main": "src/worker.py",
  "compatibility_date": "2026-09-08",
  "compatibility_flags": ["python_workers"],
  "observability": {
    "enabled": true,
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true,
  },
  "route": {
    "pattern": "ecoprimers.dennise.me",
    "custom_domain": true,
  },
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "37bab04239a542559ad6930ace664775",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOMS",
        "class_name": "Room",
      },
    ],
  },
  "migrations": [
    {
      "new_sqlite_classes": ["Room"],
      "tag": "v1",
    },
  ],
}
